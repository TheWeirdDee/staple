    function test_reservationVectors() public pure {
        QuoteEngine.Reserved memory nx;
        bool ok;
        // first bid fits
        (ok, nx) = QuoteEngine.reservationFits(QuoteEngine.Reserved(0, 0, 0, 0), 3000000000, 20000000000, true, 454770000, 3, 0, ExposureParams(3000000000, 1000000000, 5000000000, 15000000000, 10000000000, 10));
        assertTrue(ok == true, "first bid fits ok");
        assertEqU(nx.buyLots, 3, "first bid fits buyLots");
        assertEqU(nx.sellLots, 0, "first bid fits sellLots");
        assertEqU(nx.buyQuoteE8, 1365674310, "first bid fits buyQuote");
        assertEqU(nx.notionalE8, 1364310000, "first bid fits notional");
        // first ask fits
        (ok, nx) = QuoteEngine.reservationFits(QuoteEngine.Reserved(0, 0, 0, 0), 3000000000, 20000000000, false, 456610000, 3, 0, ExposureParams(3000000000, 1000000000, 5000000000, 15000000000, 10000000000, 10));
        assertTrue(ok == true, "first ask fits ok");
        assertEqU(nx.buyLots, 0, "first ask fits buyLots");
        assertEqU(nx.sellLots, 3, "first ask fits sellLots");
        assertEqU(nx.buyQuoteE8, 0, "first ask fits buyQuote");
        assertEqU(nx.notionalE8, 1369830000, "first ask fits notional");
        // bid blocked by max inventory incl. resting buys
        (ok, nx) = QuoteEngine.reservationFits(QuoteEngine.Reserved(18, 0, 8200000000, 8200000000), 3000000000, 20000000000, true, 450000000, 3, 0, ExposureParams(3000000000, 1000000000, 5000000000, 15000000000, 100000000000, 10));
        assertTrue(ok == false, "bid blocked by max inventory incl. resting buys ok");
        assertEqU(nx.buyLots, 18, "bid blocked by max inventory incl. resting buys buyLots");
        assertEqU(nx.sellLots, 0, "bid blocked by max inventory incl. resting buys sellLots");
        assertEqU(nx.buyQuoteE8, 8200000000, "bid blocked by max inventory incl. resting buys buyQuote");
        assertEqU(nx.notionalE8, 8200000000, "bid blocked by max inventory incl. resting buys notional");
        // bid exactly at max inventory boundary fits
        (ok, nx) = QuoteEngine.reservationFits(QuoteEngine.Reserved(17, 0, 8000000000, 8000000000), 3000000000, 20000000000, true, 450000000, 3, 0, ExposureParams(3000000000, 1000000000, 5000000000, 15000000000, 100000000000, 10));
        assertTrue(ok == true, "bid exactly at max inventory boundary fits ok");
        assertEqU(nx.buyLots, 20, "bid exactly at max inventory boundary fits buyLots");
        assertEqU(nx.sellLots, 0, "bid exactly at max inventory boundary fits sellLots");
        assertEqU(nx.buyQuoteE8, 9351350000, "bid exactly at max inventory boundary fits buyQuote");
        assertEqU(nx.notionalE8, 9350000000, "bid exactly at max inventory boundary fits notional");
        // ask blocked by min inventory incl. resting sells
        (ok, nx) = QuoteEngine.reservationFits(QuoteEngine.Reserved(0, 18, 0, 8200000000), 3000000000, 20000000000, false, 460000000, 3, 0, ExposureParams(3000000000, 1000000000, 5000000000, 15000000000, 100000000000, 10));
        assertTrue(ok == false, "ask blocked by min inventory incl. resting sells ok");
        assertEqU(nx.buyLots, 0, "ask blocked by min inventory incl. resting sells buyLots");
        assertEqU(nx.sellLots, 18, "ask blocked by min inventory incl. resting sells sellLots");
        assertEqU(nx.buyQuoteE8, 0, "ask blocked by min inventory incl. resting sells buyQuote");
        assertEqU(nx.notionalE8, 8200000000, "ask blocked by min inventory incl. resting sells notional");
        // opposing buys do not free sell capacity
        (ok, nx) = QuoteEngine.reservationFits(QuoteEngine.Reserved(12, 18, 5500000000, 13700000000), 3000000000, 20000000000, false, 460000000, 3, 0, ExposureParams(3000000000, 1000000000, 5000000000, 15000000000, 100000000000, 10));
        assertTrue(ok == false, "opposing buys do not free sell capacity ok");
        assertEqU(nx.buyLots, 12, "opposing buys do not free sell capacity buyLots");
        assertEqU(nx.sellLots, 18, "opposing buys do not free sell capacity sellLots");
        assertEqU(nx.buyQuoteE8, 5500000000, "opposing buys do not free sell capacity buyQuote");
        assertEqU(nx.notionalE8, 13700000000, "opposing buys do not free sell capacity notional");
        // insufficient quote balance
        (ok, nx) = QuoteEngine.reservationFits(QuoteEngine.Reserved(0, 0, 0, 0), 3000000000, 1360000000, true, 454770000, 3, 0, ExposureParams(3000000000, 1000000000, 5000000000, 15000000000, 10000000000, 10));
        assertTrue(ok == false, "insufficient quote balance ok");
        assertEqU(nx.buyLots, 0, "insufficient quote balance buyLots");
        assertEqU(nx.sellLots, 0, "insufficient quote balance sellLots");
        assertEqU(nx.buyQuoteE8, 0, "insufficient quote balance buyQuote");
        assertEqU(nx.notionalE8, 0, "insufficient quote balance notional");
        // insufficient base balance for ask
        (ok, nx) = QuoteEngine.reservationFits(QuoteEngine.Reserved(0, 0, 0, 0), 200000000, 20000000000, false, 456610000, 3, 0, ExposureParams(0, 0, 5000000000, 15000000000, 10000000000, 10));
        assertTrue(ok == false, "insufficient base balance for ask ok");
        assertEqU(nx.buyLots, 0, "insufficient base balance for ask buyLots");
        assertEqU(nx.sellLots, 0, "insufficient base balance for ask sellLots");
        assertEqU(nx.buyQuoteE8, 0, "insufficient base balance for ask buyQuote");
        assertEqU(nx.notionalE8, 0, "insufficient base balance for ask notional");
        // outstanding notional cap counts orders awaiting cancel
        (ok, nx) = QuoteEngine.reservationFits(QuoteEngine.Reserved(6, 15, 2740000000, 9500000000), 3000000000, 20000000000, true, 454770000, 3, 0, ExposureParams(3000000000, 1000000000, 5000000000, 15000000000, 10000000000, 10));
        assertTrue(ok == false, "outstanding notional cap counts orders awaiting cancel ok");
        assertEqU(nx.buyLots, 6, "outstanding notional cap counts orders awaiting cancel buyLots");
        assertEqU(nx.sellLots, 15, "outstanding notional cap counts orders awaiting cancel sellLots");
        assertEqU(nx.buyQuoteE8, 2740000000, "outstanding notional cap counts orders awaiting cancel buyQuote");
        assertEqU(nx.notionalE8, 9500000000, "outstanding notional cap counts orders awaiting cancel notional");
        // quote budget includes fee allowance (rounded up)
        (ok, nx) = QuoteEngine.reservationFits(QuoteEngine.Reserved(0, 0, 13640000000, 0), 3000000000, 50000000000, true, 454770000, 3, 0, ExposureParams(3000000000, 1000000000, 5000000000, 15008000000, 10000000000, 10));
        assertTrue(ok == true, "quote budget includes fee allowance (rounded up) ok");
        assertEqU(nx.buyLots, 3, "quote budget includes fee allowance (rounded up) buyLots");
        assertEqU(nx.sellLots, 0, "quote budget includes fee allowance (rounded up) sellLots");
        assertEqU(nx.buyQuoteE8, 15005674310, "quote budget includes fee allowance (rounded up) buyQuote");
        assertEqU(nx.notionalE8, 1364310000, "quote budget includes fee allowance (rounded up) notional");
    }
