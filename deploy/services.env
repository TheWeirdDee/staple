# Hosted testnet services (read by .github/workflows/services.yml). No secrets belong here.
STAPLE_RUN_MINUTES=340
STAPLE_CAMPAIGN_ID=g1
# Mandate 1 is a draft until HyperCore testnet funds arrive, so heartbeats guard nothing yet: a slow interval keeps
# the watcher's small gas balance alive. Set it to 10 before activation (the policy's watcher timeout is 45 s).
STAPLE_WATCH_INTERVAL=120
